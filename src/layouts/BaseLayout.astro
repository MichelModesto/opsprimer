---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: object;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const ogImage = new URL('/og-default.svg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Fontes auto-hospedadas: preload das duas que pintam o primeiro texto. */}
    <link rel="preload" href="/fonts/newsreader-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/publicsans-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpsPrimer" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Verificacao da rede de afiliados Impact — publica por natureza. */}
    <meta name="impact-site-verification" value="0963f78d-2a58-41d7-b254-7ced3a9457a4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap-wide">
        <a class="brand" href="/">Ops<em>Primer</em></a>
        <nav aria-label="Main">
          <a href="/articles/" aria-current={path.startsWith('/articles') ? 'page' : undefined}>Articles</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap"><slot /></main>

    <footer class="site-footer">
      <div class="wrap-wide">
        <nav aria-label="Footer">
          <a href="/articles/">Articles</a>
          <a href="/about/">About</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy-policy/">Privacy</a>
        </nav>
        <p>© {new Date().getFullYear()} OpsPrimer — written by Michel Modesto in Brazil.</p>
      </div>
    </footer>
  </body>
</html>
