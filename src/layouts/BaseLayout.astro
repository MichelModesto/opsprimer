---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Verificacao de propriedade da rede de afiliados Impact.
        Publica por natureza — nao e segredo. */}
    <meta name="impact-site-verification" value="0963f78d-2a58-41d7-b254-7ced3a9457a4" />
    <style>
      :root { --fg:#1a1a1a; --muted:#666; --bg:#fff; --accent:#0b5fff; --line:#e5e5e5; }
      @media (prefers-color-scheme: dark) {
        :root { --fg:#e8e8e8; --muted:#9a9a9a; --bg:#141414; --accent:#7aa2ff; --line:#2c2c2c; }
      }
      * { box-sizing: border-box; }
      body {
        margin:0; background:var(--bg); color:var(--fg);
        font:17px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
      }
      .wrap { max-width:44rem; margin:0 auto; padding:0 1.25rem; }
      header { border-bottom:1px solid var(--line); padding:1.25rem 0; }
      header nav { display:flex; gap:1.25rem; align-items:baseline; flex-wrap:wrap; }
      header .brand { font-weight:700; text-decoration:none; color:var(--fg); }
      a { color:var(--accent); }
      main { padding:2.5rem 0 4rem; }
      h1 { font-size:2rem; line-height:1.2; margin:0 0 .5rem; }
      h2 { margin-top:2.5rem; }
      footer { border-top:1px solid var(--line); padding:2rem 0; color:var(--muted); font-size:.9rem; }
      footer nav { display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:.75rem; }
      .disclosure {
        border:1px solid var(--line); border-left:3px solid var(--accent);
        padding:.85rem 1rem; margin:0 0 2rem; font-size:.92rem; color:var(--muted);
      }
      article :is(table) { width:100%; border-collapse:collapse; }
      article :is(td,th) { border:1px solid var(--line); padding:.5rem; text-align:left; }
      article pre { overflow-x:auto; padding:1rem; border:1px solid var(--line); }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <nav>
          <a class="brand" href="/">OpsPrimer</a>
          <a href="/articles/">Articles</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer>
      <div class="wrap">
        <nav>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy-policy/">Privacy</a>
          <a href="/about/">About</a>
        </nav>
        <p>© {new Date().getFullYear()} OpsPrimer</p>
      </div>
    </footer>
  </body>
</html>
