---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title="OpsPrimer — CRM and agency operations, from someone who wires them up"
  description="Practical guides on CRMs, automation and operations for marketing agencies and consultants — written from real accounts, not feature grids."
>
  <h1>CRM advice from the person who has to make it work</h1>

  <p class="lede">
    Most writing about these tools comes from people who evaluate them. I'm
    usually the one wiring them into billing systems and finding out what breaks
    six months in. Everything here is written from an account I set up and use.
  </p>

  <h2>Articles</h2>
  <ul class="post-list">
    {articles.map((a) => (
      <li>
        <a class="post-link" href={`/articles/${a.id}/`}>
          <div class="post-title">{a.data.title}</div>
          <div class="post-desc">{a.data.description}</div>
          <div class="post-date">{fmt(a.data.pubDate)}</div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
