---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="OpsPrimer — CRM and agency operations, from someone who wires them up"
  description="Practical guides on CRMs, automation and operations for marketing agencies and consultants."
>
  <h1>CRM advice from the person who has to make it work</h1>
  <p>
    Practical write-ups on CRMs and the automation around them, from running
    these tools on real client work — including what went wrong.
  </p>

  <h2>Latest</h2>
  <ul>
    {articles.map((a) => (
      <li>
        <a href={`/articles/${a.id}/`}>{a.data.title}</a>
        <div style="color:var(--muted);font-size:.92rem">{a.data.description}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
