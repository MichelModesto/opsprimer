---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclosure from '../../components/Disclosure.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: { article, next: articles[i + 1] ?? articles[i - 1] ?? null },
  }));
}

const { article, next } = Astro.props;
const { Content } = await render(article);

// Tempo de leitura estimado a partir do corpo do MDX.
const words = article.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article>
    <h1>{article.data.title}</h1>
    <p class="lede">{article.data.description}</p>

    <div class="article-meta">
      <span>By Michel Modesto</span>
      <time datetime={article.data.pubDate.toISOString()}>{fmt(article.data.pubDate)}</time>
      {article.data.updatedDate && (
        <span>Updated {fmt(article.data.updatedDate)}</span>
      )}
      <span>{minutes} min read</span>
    </div>

    <Disclosure />
    <Content />
    <AuthorBox />

    {next && (
      <nav class="next-up">
        <div class="label">Read next</div>
        <a href={`/articles/${next.id}/`}>{next.data.title}</a>
      </nav>
    )}
  </article>
</BaseLayout>
