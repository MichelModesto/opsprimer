---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclosure from '../../components/Disclosure.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article>
    <h1>{article.data.title}</h1>
    <p style="color:var(--muted);font-size:.9rem">
      Published {article.data.pubDate.toISOString().slice(0, 10)}
      {article.data.updatedDate && ` · Updated ${article.data.updatedDate.toISOString().slice(0, 10)}`}
    </p>
    <Disclosure />
    <Content />
  </article>
</BaseLayout>
