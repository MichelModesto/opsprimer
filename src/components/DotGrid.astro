---
// ELEMENTO ASSINATURA. Numeros medidos numa conta HubSpot real (14/08/2026):
// 213 propriedades de contato de fabrica. Uma agencia pequena usa ~15.
// Os 15 acesos sao deterministicos — nada de Math.random, que quebraria o build.
const TOTAL = 213;
const USED = 15;
const step = Math.floor(TOTAL / USED);
const lit = new Set(Array.from({ length: USED }, (_, i) => i * step + 3));
---
<figure class="dotgrid">
  <div class="dotgrid-key">
    <span class="on">actually used</span>
    <span>ships by default</span>
  </div>
  <div class="dotgrid-grid" role="img"
       aria-label={`${TOTAL} contact properties ship with an empty HubSpot account; a small agency uses about ${USED}.`}>
    {Array.from({ length: TOTAL }, (_, i) => <i class={lit.has(i) ? 'on' : undefined} />)}
  </div>
  <figcaption class="dotgrid-caption">
    <b>213 contact properties</b> ship with an empty HubSpot account, before a
    single contact exists. A small agency uses about fifteen. Every one of the
    others sits in your import mapping, your filters and your form builder —
    permanently. <b>I counted them.</b>
  </figcaption>
</figure>
